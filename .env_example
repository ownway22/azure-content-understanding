# Azure Content Understanding 服務端點和金鑰
ENDPOINT="your-azure-endpoint-here"
KEY="your-api-key-here"

# 文件分析器設定
DOC_ANALYZER_ID="prebuilt-documentAnalyzer"
DOC_FILE_URL="https://github.com/Azure-Samples/azure-ai-content-understanding-python/raw/refs/heads/main/data/invoice.pdf"

# 圖片分析器設定
IMG_ANALYZER_ID="prebuilt-imageAnalyzer"
IMG_FILE_URL="https://github.com/Azure-Samples/azure-ai-content-understanding-python/raw/refs/heads/main/data/pieChart.jpg"

# 音訊分析器設定
AUDIO_ANALYZER_ID="prebuilt-audioAnalyzer"
AUDIO_FILE_URL="https://github.com/Azure-Samples/azure-ai-content-understanding-python/raw/refs/heads/main/data/audio.wav"

# 影片分析器設定
VIDEO_ANALYZER_ID="prebuilt-videoAnalyzer"
VIDEO_FILE_URL="https://github.com/Azure-Samples/azure-ai-content-understanding-python/raw/refs/heads/main/data/FlightSimulator.mp4"
